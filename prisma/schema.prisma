generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String         @id @unique
  email                  String         @unique
  name                   String?
  stripeCustomerId       String?        @unique
  monthlyDatasetsLimit   Int            @default(1)
  currentDatasetsUsage   Int            @default(0)
  monthlyAIInsightsLimit Int            @default(3)
  currentAIInsightsUsage Int            @default(0)
  dailyDataPointsLimit   Int            @default(100)
  currentDataPointsUsage Int            @default(0)
  lastAIReset            DateTime       @default(now())
  lastDataPointsReset    DateTime       @default(now())
  timezone               String         @default("Europe/Madrid")
  notificationsEmail     Boolean        @default(true)
  notificationsSlack     Boolean        @default(false)
  slackWebhookUrl        String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  activityLogs           ActivityLog[]
  apiKeys                ApiKey[]
  datasets               Dataset[]
  insights               Insight[]
  notifications          Notification[]
  subscription           Subscription?

  @@index([email])
}

model Subscription {
  stripeSubscriptionId String   @id @unique
  status               String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  interval             String
  planId               String
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}


model MetricConfig {
  id            String   @id @default(cuid())
  datasetId     String
  
  // Basic Configuration
  name          String
  color         String   @default("#3b82f6")
  valueSelector String   // JSONPath o dot notation: "metadata.cargo.passengers.current"
  
  // Aggregation & Processing
  aggregation   String   @default("none") // "none" | "avg" | "sum" | "min" | "max" | "count"
  windowSize    Int      @default(50)     // Número de puntos a mantener en la visualización
  
  // Chart Configuration
  chartType     String   @default("line") // "line" | "area" | "bar" | "scatter" | "gauge" | "distribution"
  showStats     Boolean  @default(true)
  
  // Display Options
  unit          String?                    // "km/h", "°C", "%", etc.
  decimals      Int      @default(2)
  
  // 🆕 Advanced Chart Options
  // Para Scatter Plot: correlacionar dos variables (X vs Y)
  secondaryValueSelector String? // e.g., "metadata.cargo.passengers.occupancyRate"
  filters                 Json?
  // Para Bar/Distribution: agrupar datos por categoría
  groupBySelector        String? // e.g., "metadata.sensorType" o "metadata.serviceType"
  
  // Para Gauge: umbrales de color personalizables
  thresholds             Json?   // Array de { value: number, color: string, label: string }
  // Ejemplo: [
  //   { "value": 30, "color": "#ef4444", "label": "Low" },
  //   { "value": 70, "color": "#f59e0b", "label": "Medium" },
  //   { "value": 100, "color": "#10b981", "label": "High" }
  // ]
  
  // 🆕 Additional Configuration
  description   String?  // Descripción de qué mide esta métrica
  isVisible     Boolean  @default(true) // Permitir ocultar métricas sin eliminarlas
  sortOrder     Int      @default(0)    // Orden de visualización en la UI
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  dataset       Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  
  // Indexes
  @@unique([datasetId, name]) // Prevenir nombres duplicados en el mismo dataset
  @@index([datasetId, sortOrder]) // Para ordenar métricas
  @@index([datasetId, isVisible]) // Para filtrar métricas visibles
  @@index([datasetId, createdAt])
}


model Dataset {
  id               String      @id @default(cuid())
  userId           String
  name             String
  description      String?
  status           String      @default("active")
  source           String
  
  // 🆕 Nuevo campo para tipo de visualización
  viewType         String      @default("gis") // "gis" o "threejs"
  metrics          MetricConfig[]

  
  mqttBroker       String?
  mqttTopic        String?
  mqttUsername     String?
  mqttPassword     String?
  webhookUrl       String?     @unique
  webhookSecret    String?
  apiEndpoint      String?
  boundingBox      Json?
  totalDataPoints  Int         @default(0)
  dataPointsToday  Int         @default(0)
  lastDataReceived DateTime?
  avgUpdateFreq    Int?
  alertsEnabled    Boolean     @default(false)
  alertThresholds  Json?       // Mantener por compatibilidad, migrar después
  alertRules       AlertRule[] // 🆕 AGREGAR ESTO
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  maxDataPoints    Int         @default(100)
  alerts           Alert[]
  dataPoints       DataPoint[]
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  insights         Insight[]
  layers           Layer[]
  mapping          DatasetMapping?

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([viewType]) // 🆕 Índice para filtrar por tipo
}

model DatasetMapping {
  id        String   @id @default(cuid())
  datasetId String   @unique
  
  // Paths para mapear campos del payload MQTT
  valuePath      String   @default("value")
  
  // 🆕 Paths para coordenadas - ahora son más flexibles
  // Para GIS: x=longitude, y=latitude, z=altitude
  // Para ThreeJS: x, y, z en espacio cartesiano
  xPath          String?  @default("x")
  yPath          String?  @default("y")
  zPath          String?  @default("z")
  
  sensorIdPath   String?  @default("sensorId")
  sensorTypePath String?  @default("sensorType")
  timestampPath  String   @default("timestamp")
  unitPath       String?  @default("unit")
  
  // Metadata adicional
  metadata  Json?
  
  // Configuración de transformaciones
  transforms Json?  // Para futuras transformaciones (ej: escalado, conversión de unidades)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  dataset   Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  
  @@index([datasetId])
}

model SensorConfig {
  id        String   @id @default(cuid())
  datasetId String
  sensorId  String
  name      String?
  type      String?
  unit      String?
  location  Json?
  metadata  Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([datasetId, sensorId])
  @@index([datasetId])
}

model DataPoint {
  id             String   @id @default(cuid())
  datasetId      String
  value          Float
  sensorId       String
  
  // 🆕 Coordenadas ahora guardadas directamente
  // Para GIS: x=longitude, y=latitude, z=altitude
  // Para ThreeJS: x, y, z en espacio cartesiano
  x              Float?
  y              Float?
  z              Float?
  
  metadata       Json?
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now())
  isLatest       Boolean  @default(true)
  sensorConfigId String?
  dataset        Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId, timestamp(sort: Desc)])
  @@index([sensorId, timestamp(sort: Desc)])
  @@index([datasetId, x, y, z]) // 🆕 Índice espacial para queries geográficas
}

model Layer {
  id          String   @id @default(cuid())
  datasetId   String
  name        String
  description String?
  enabled     Boolean  @default(true)
  order       Int      @default(0)
  
  // ✅ Tipo de asset (móvil, estático, área)
  assetType   String   @default("point") // "point" | "moving" | "area"
  
  // ============================================
  // CONFIGURACIÓN DE VISUALIZACIÓN
  // ============================================
  
  // Tipo de renderizado
  renderType  String   @default("marker") // "marker" | "icon" | "image" | "model3d" | "shape"
  
  // ✅ Configuración de marcadores/iconos
  markerConfig Json?   // { iconName?: string, iconLibrary?: "lucide" | "custom" }
  
  // ✅ URL de imagen personalizada
  imageUrl    String?
  
  // ✅ URL de modelo 3D (GLB)
  modelUrl    String?
  
  // ✅ Configuración completa del modelo 3D para Mapbox
  model3dConfig Json?  
  // {
  //   scale: [number, number, number],
  //   rotation: [number, number, number],
  //   translate: [number, number, number],
  //   orientation?: "map" | "viewport" | "auto",
  //   anchor?: "center" | "bottom" | "top",
  //   autoRotate?: boolean,
  //   autoRotateOffset?: number,
  //   minZoom?: number,
  //   maxZoom?: number,
  //   scaleWithZoom?: boolean,
  //   scaleRange?: [number, number],
  //   animations?: { idle?: string, moving?: string, speed?: number },
  //   castShadows?: boolean,
  //   receiveShadows?: boolean,
  //   metalness?: number,
  //   roughness?: number,
  //   emissiveIntensity?: number,
  //   frustumCulling?: boolean,
  //   lodEnabled?: boolean,
  //   lodDistances?: number[],
  //   clickable?: boolean,
  //   hoverable?: boolean,
  //   altitudeMode?: "absolute" | "relative" | "clampToGround",
  //   heightOffset?: number
  // }
  
  // ✅ Configuración de shapes/polígonos
  shapeConfig Json?   // { type: "circle" | "polygon" | "rectangle", coordinates?: [...] }
  
  // ============================================
  // ESTILO Y APARIENCIA
  // ============================================
  
  colorScheme Json?    // Esquema de colores existente (gradient, solid, etc.)
  opacity     Float    @default(1.0)
  pointSize   Float    @default(1.0)  // Escala del asset (multiplicador)
  
  // ✅ Configuración de borde
  borderConfig Json?   // { width: number, color: string, style: "solid" | "dashed" }
  
  // ✅ Configuración de sombra
  shadowConfig Json?   // { enabled: boolean, color: string, blur: number, offsetX: number, offsetY: number }
  
  // ============================================
  // COMPORTAMIENTO DINÁMICO
  // ============================================
  
  // ✅ Reglas de color dinámico
  colorRules   Json?   // Array de { condition: string, colorScheme: ColorScheme }
  
  // ✅ Reglas de escala dinámica
  scaleRules   Json?   // Array de { condition: string, scale: number }
  
  // ✅ Reglas de visibilidad
  visibilityRules Json? // Array de { condition: string, visible: boolean }
  
  // ============================================
  // CONFIGURACIÓN DE TRAIL (para assets móviles)
  // ============================================
  
  // ✅ Habilitar trail/estela
  showTrail       Boolean @default(false)
  trailLength     Int     @default(50)      // Número de puntos históricos
  trailWidth      Float   @default(2.0)     // Ancho de la línea
  trailOpacity    Float   @default(0.6)     // Opacidad del trail
  
  // ✅ Modo de color del trail
  trailColorMode  String  @default("static") // "static" | "dynamic" | "gradient" | "rules"
  
  // ✅ Esquema de colores estático/gradient
  trailColorScheme Json?  // ColorScheme para modos static/gradient
  
  // ✅ NUEVO: Reglas de color del trail
  trailColorRules  Json?  
  // Array de reglas: [{
  //   id: string,
  //   name: string,
  //   priority: number,
  //   applicationType: "entire-trail" | "current-segment" | "future-segments" | "historical",
  //   enabled: boolean,
  //   description?: string,
  //   condition: string,  // Expresión evaluable: "metadata.speed > 80"
  //   color: string       // Color a aplicar
  // }]
  
  // ✅ NUEVO: Configuración de gradiente histórico
  trailGradientConfig Json?
  // {
  //   enabled: boolean,
  //   fadeOldSegments?: boolean,      // Atenuar segmentos antiguos
  //   fadeStartAge?: number,          // Edad en ms donde empieza el fade
  //   fadeEndAge?: number,            // Edad en ms donde termina el fade
  //   minOpacity?: number             // Opacidad mínima (0.0 - 1.0)
  // }
  
  // ✅ NUEVO: Configuración de validación del trail
  trailValidationConfig Json?
  // {
  //   enableValidation?: boolean,
  //   minDistanceThreshold?: number,  // Distancia mínima entre puntos
  //   maxTimeBetweenPoints?: number   // Tiempo máximo en ms antes de reset
  // }
  
  // ✅ NUEVO: Configuración de puntos históricos
  trailPointsConfig Json?
  // {
  //   showHistoricalPoints?: boolean,  // Mostrar puntos en el trail
  //   pointInterval?: number,          // Cada cuántos puntos mostrar
  //   pointSize?: number,              // Tamaño de los puntos
  //   pointOpacity?: number,           // Opacidad de los puntos
  //   fadeWithAge?: boolean            // Fade según antigüedad
  // }
  
  // ============================================
  // FILTROS Y QUERIES
  // ============================================
  
  filterQuery String?
  
  // ============================================
  // METADATA
  // ============================================
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId, order])
  @@index([datasetId, enabled])
  @@index([assetType])
  @@index([renderType])
  @@index([showTrail])
}


model AlertRule {
  id              String   @id @default(cuid())
  datasetId       String
  
  // Configuración de la regla
  name            String
  description     String?
  metricPath      String   // "value" o "metadata.temperature" o "metadata.speed"
  condition       String   // "greater_than", "less_than", "equals", "not_equals", "between"
  thresholdValue  Float
  thresholdMax    Float?   // Para condition "between"
  severity        String   // "info", "warning", "critical"
  
  // Control y comportamiento
  enabled         Boolean  @default(true)
  cooldownMinutes Int      @default(15) // No disparar la misma alerta repetidamente
  
  // Notificaciones
  notifyEmail     Boolean  @default(true)
  notifySlack     Boolean  @default(false)
  
  // Metadata
  lastTriggered   DateTime?
  triggerCount    Int      @default(0)
  
  // Relaciones
  dataset         Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  alerts          Alert[]  // Alertas que esta regla ha disparado
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([datasetId, enabled])
  @@index([datasetId, createdAt])
}

model Alert {
  id             String     @id @default(cuid())
  datasetId      String
  alertRuleId    String?    // 🆕 AGREGAR ESTO
  
  name           String
  condition      String
  thresholdValue Float
  currentValue   Float
  status         String     @default("active")
  severity       String
  message        String
  triggeredAt    DateTime   @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  mutedUntil     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  
  dataset        Dataset    @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  alertRule      AlertRule? @relation(fields: [alertRuleId], references: [id], onDelete: SetNull) // 🆕 AGREGAR ESTO

  @@index([datasetId, status])
  @@index([status, severity])
  @@index([alertRuleId]) // 🆕 AGREGAR ESTO
}

model Insight {
  id               String    @id @default(cuid())
  userId           String
  datasetId        String
  type             String
  severity         String
  title            String
  summary          String
  details          String?
  recommendations  String?
  affectedArea     Json?
  metricsDelta     Json?
  isResolved       Boolean   @default(false)
  resolvedAt       DateTime?
  resolvedBy       String?
  modelUsed        String?   @default("gemini-2.0-flash-exp")
  confidence       Float?
  processingTimeMs Int?
  tokensUsed       Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  dataset          Dataset   @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([datasetId, severity])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String    @default("info")
  title       String
  message     String
  isRead      Boolean   @default(false)
  readAt      DateTime?
  relatedType String?
  relatedId   String?
  actionUrl   String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  key        String    @unique
  prefix     String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  rateLimit  Int       @default(1000)
  usageCount Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}